{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "goal":{
            "_comment": [
                "Using 'goal' as the name of an option let you override some of the generated goal parameters"
            ],
            "display_name": "The End Objective",
            "description": "How to End your Randomized playthrough.",
            "aliases": {"easiest": 0},
            "hidden": false
        },
        "death_link": {
            "display_name": "Death Link",
            "default": false
        },
        "filler_traps": {
            "display_name": "Filler Trap Percentage",
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 20
            },
            "type": "Range",
            "range_start": 0,
            "range_end": 100,
            "default": 20
        }
    },
    "user": {
        "_commented_out_option":{
            "type": "Toggle",
            "default": true
        },
        "start_with_killer": {
            "display_name": "Start with Killer",
            "description": [
                "When enabled, you begin the randomizer with a random killer."
            ],
            "type": "Toggle",
            "default": false,
            "group": "Randomization Options"
        },
        "enable_hard_locations": {
            "display_name": "Enable Hard Locations",
            "description": [
                "Includes checks that are deemed incredibly difficult.",
                "Hard Checks include: I'm Just Saiyan', Double or Nothing, Spec-Tater, Combat Medic, Deep Dive, and Every DoD YouTuber Be Like."
            ],
            "type": "Toggle",
            "default": false,
            "group": "Randomization Options"
        },
        "tasksanity": {
            "display_name": "Tasksanity",
            "description": [
                "Adds checks for completing each civilian task."
            ],
            "type": "Toggle",
            "default": true,
            "group": "Randomization Options"
        },
        "s-rank_checks": {
            "display_name": "S-rank Checks",
            "description": [
                "Adds checks for S-ranking as each Civilian Ability and Killer."
            ],
            "type": "Toggle",
            "default": true,
            "group": "Randomization Options"
        },
        "separate_synergy_checks": {
            "display_name": "Separate Synergy Checks",
            "description": [
                "When enabled, adds checks for winning and S-ranking (if enabled) as each Synergy.",
                "It is up to you to decide if winning as a synergy does not count for its base abilities' checks."
            ],
            "type": "Toggle",
            "default": true,
            "group": "Randomization Options"
        },
        "include_special_gamemodes": {
            "display_name": "Include Special Gamemodes",
            "description": [
                "Adds checks that involve the special gamemodes.",
                "Warning: These checks might take a long time to get."
            ],
            "type": "Toggle",
            "default": false,
            "group": "Randomization Options"
        },
        "include_arcade_checks":{
            "display_name": "Enable Arcade Checks",
            "description": [
                "Adds locations for getting achievements in Sauce Simulator and One Night at Dobo's"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Randomization Options"
        },
        "randomize_arcade_cabinets":{
            "display_name": "Randomize Arcade Cabinets",
            "description": [
                "Randomizes Arcade Cabinets into the item pool.",
                "Arcade Cabinets will need to be found before you can do checks related to the arcade games."
            ],
            "type": "Toggle",
            "default": true,
            "group": "Randomization Options"
        },
        "saucesanity":{
            "display_name": "Saucesanity",
            "description": [
                "Adds checks for each rebirth in Saucesanity.",
                "Each rebirth now requires a Progressive Rebirth."
            ],
            "type": "Toggle",
            "default": false,
            "group": "Randomization Options"
        }
    }
}
